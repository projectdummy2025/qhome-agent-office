# ── LLM Provider (SumoPod AI Gateway) ─────────────────────────────────────────
SUMOPOD_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUMOPOD_API_BASE=https://ai.sumopod.com/v1
SUPERVISOR_MODEL=glm-5-turbo
SUBAGENT_MODEL=gpt-5-nano

# Opsional — riset internet via Tavily
TAVILY_API_KEY=

# ── Database ────────────────────────────────────────────────────────────────────
# Untuk mode LOKAL (backend langsung di host)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/qhome_db

# Untuk mode DOCKER — ganti localhost → postgres (nama service Docker Compose)
# DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/qhome_db

# ── ChromaDB ────────────────────────────────────────────────────────────────────
# Untuk mode LOKAL
CHROMA_HOST=localhost
CHROMA_PORT=8080

# Untuk mode DOCKER — ganti ke nama service
# CHROMA_HOST=chromadb
# CHROMA_PORT=8000

# ── Kredensial PostgreSQL (dipakai Docker Compose) ─────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=qhome_db

# ── Seeding ─────────────────────────────────────────────────────────────────────
# true  = seed otomatis saat backend pertama kali start
# false = skip (jika data sudah ada)
SEED_ON_STARTUP=true

# ── Server ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
